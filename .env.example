# Copie este arquivo para .env e preencha os valores

# Banco de dados (Supabase)
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT].supabase.co:5432/postgres

# JWT Secret (gere uma string aleatória longa)
JWT_SECRET=coloque_uma_string_secreta_longa_aqui_123456

# Segredo do painel admin
ADMIN_SECRET=coloque_um_admin_secret_forte_aqui

# API de emails (opcional)
RESEND_API_KEY=
EMAIL_FROM=suporte@bubuya.com.br

# App
APP_BRAND=Bubuya
APP_DOMAIN=bubuya.com.br
APP_URL=https://bubuya.com.br
SUPPORT_EMAIL=suporte@bubuya.com.br
ADMIN_EMAIL=l245602@dac.unicamp.br

# Webhook da Transak
TRANSAK_SECRET_KEY=

# InfinitePay
INFINITEPAY_HANDLE=
INFINITEPAY_REDIRECT_URL=
INFINITEPAY_WEBHOOK_URL=
# Secret para validar assinatura HMAC dos webhooks da InfinitePay
INFINITEPAY_WEBHOOK_SECRET=

# Web Push / VAPID (gere com: node -e "const wp=require('web-push'); console.log(JSON.stringify(wp.generateVAPIDKeys()))")
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:suporte@bubuya.com.br

# Porta do servidor
PORT=3000

# Ambiente
NODE_ENV=development
