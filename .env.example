# Copie este arquivo para .env e preencha os valores

# Banco de dados (Supabase)
DATABASE_URL=postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJECT].supabase.co:5432/postgres

# JWT Secret (gere uma string aleatória longa)
JWT_SECRET=coloque_uma_string_secreta_longa_aqui_123456

# Segredo do painel admin
ADMIN_SECRET=coloque_um_admin_secret_forte_aqui

# API de emails (opcional)
RESEND_API_KEY=

# Webhook da Transak
TRANSAK_SECRET_KEY=

# Porta do servidor
PORT=3000

# Ambiente
NODE_ENV=development
